# Connection string for MigrationGuard's own application database.
# Do not point this at a production database.
DATABASE_URL=postgresql://migrationguard:migrationguard@localhost:5432/migrationguard

# The Docker image used for disposable migration-test databases.
POSTGRES_TEST_IMAGE=postgres:16-alpine

# Maximum allowed migration size in bytes (100 KB).
MAX_MIGRATION_SIZE_BYTES=102400

# Maximum time allowed for a test migration, in milliseconds.
MIGRATION_TIMEOUT_MS=30000

# Optional: only used by the future AI explanation feature, on the server.
# OPENAI_API_KEY=
